{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        "public/r/**",
        "storybook-static/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../packages/registry/src/**",
        "../../packages/registry/tests/**"
      ]
    }
  }
}
